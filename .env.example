# Backend
BACKEND_PORT=8000
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
OLLAMA_READ_TIMEOUT_SECONDS=600
OLLAMA_MAX_TOKENS=128
OLLAMA_KEEP_ALIVE=30m

# Expo / LAN access
# Set these to the LAN IP of the machine running Docker, e.g. 192.168.1.20
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.20
EXPO_PUBLIC_API_BASE=http://192.168.1.20:8000
EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0
EXPO_TUNNEL=0
